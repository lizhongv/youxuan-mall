# 复制为 .env 后修改。所有密码上线前必须替换为随机值（如 openssl rand -base64 24）
#
# 运行模式（见 deploy/mall/README.md「运行模式」）：
#   prod（默认）：真实营业。强制关闭模拟支付、验证码回显与接口文档，admin 首次登录强制改密；
#                 JWT 密钥、数据库 / Redis 密码仍是占位值（change-me…）、弱口令或过短时服务端拒绝启动。
#   demo        ：演示机 / 冒烟测试。可开启模拟支付与验证码回显，/doc.html 可用。切勿用于真实营业。
MALL_PROFILE=prod

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-mall
REDIS_PASSWORD=change-me-redis
# JWT 签名密钥，≥ 32 字节随机串（openssl rand -base64 48）；prod 下为占位值或过短会拒绝启动
MALL_JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
# 首次启动创建的后台账号 admin 的密码（只在首次建库时生效）；prod 下首次登录会被强制修改
MALL_INIT_ADMIN_PASSWORD=admin123
# 以下两项只在 MALL_PROFILE=demo 时生效，prod 下无论填什么都会被强制为 false
# 未接入短信渠道时设为 true：验证码直接返回给前端（仅限演示）
MALL_SMS_DEV_MODE=false
# 模拟支付（立即成功，仅限演示）
MALL_PAY_MOCK_ENABLED=false
HTTP_PORT=8090
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

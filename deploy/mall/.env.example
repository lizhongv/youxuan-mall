# 复制为 .env 后修改。所有密码上线前必须替换为随机值（如 openssl rand -base64 24）
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-mall
REDIS_PASSWORD=change-me-redis
# JWT 签名密钥，≥ 32 字节
MALL_JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
# 首次启动创建的后台账号 admin 的密码，登录后请立即修改
MALL_INIT_ADMIN_PASSWORD=admin123
# 未接入短信渠道时为 true：验证码直接返回给前端（仅限演示）
MALL_SMS_DEV_MODE=true
# 模拟支付（演示用）；接入微信/支付宝后设为 false
MALL_PAY_MOCK_ENABLED=true
HTTP_PORT=8090
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
